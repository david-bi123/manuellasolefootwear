# ---------------------------------------------------------------------------
# Manuella Sole Footwear — environment variables
# Copy to .env.local and fill in real values. Never commit real credentials.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (production database)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/manuella?retryWrites=true&w=majority

# Cloudinary (product image storage). Leave blank to fall back to image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL (no trailing slash). Used for canonical links, OG tags,
# sitemap/robots, JSON-LD and WhatsApp product links.
# On Vercel set this to your production domain, e.g. https://manuellasolefootwear.vercel.app
APP_SITE_URL=http://localhost:3000
# (NEXT_PUBLIC_SITE_URL is still honoured as a legacy fallback if APP_SITE_URL is not set.)

# Business WhatsApp number in international format, digits only (e.g. 233241234567).
# Can also be managed from Admin > Settings once the database is seeded.
WHATSAPP_NUMBER=233241234567

# Long random string used to sign admin session cookies (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Owner bootstrap credentials (used only by `npm run create-owner`)
OWNER_EMAIL=owner@manuellasole.com
OWNER_PASSWORD=
OWNER_NAME=Manuella Owner

# Samtech Labs super admin (platform operator). Used only by
# `npm run create-superadmin`. This account can pause / resume the site from
# Admin > Platform, and is the only account that can sign in while paused.
SUPERADMIN_EMAIL=admin@samtechlabs.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Samtech Labs

# Developer contact details shown on the paused-storefront notice.
# Can also be set from Admin > Platform once the site is seeded.
DEVELOPER_NAME=Samtech Labs
DEVELOPER_EMAIL=
DEVELOPER_PHONE=
DEVELOPER_WHATSAPP=
